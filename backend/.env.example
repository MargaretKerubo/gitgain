# Server Configuration
PORT=8080
DB_PATH=gitgain.db

# Lightning Integration Mode: "mock" or "lnd"
LIGHTNING_MODE=mock

# LND REST Config (Required if LIGHTNING_MODE=lnd)
# In Polar, copy the REST host URL (e.g. 127.0.0.1:8081)
LND_REST_HOST=https://127.0.0.1:8081
# In Polar, copy the admin macaroon in Hex format
LND_MACAROON_HEX=0201036c6e64...
# For local Polar testing, skip TLS cert validation
LND_SKIP_TLS_VERIFY=true

# GitHub Config (Required for Webhook Verification in Stage 4)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_if_needed
